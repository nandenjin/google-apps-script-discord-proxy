worker_processes auto;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/json;
    access_log /dev/stdout combined;
    sendfile on;
    keepalive_timeout 65;

    server {
        listen ${PORT};
        server_name _;

        # Validate discord-authorization header
        if ($http_discord_authorization = "") {
            return 400 "No discord-authorization header";
        }

        location / {
            proxy_pass https://discord.com/api/;
            proxy_ssl_server_name on;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;

            # Header transformations
            proxy_set_header Host discord.com;
            proxy_set_header Authorization $http_discord_authorization;
            proxy_set_header User-Agent "DiscordBot ($http_host, ${VERSION})";
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header discord-authorization "";

            proxy_http_version 1.1;
            proxy_set_header Connection "";

            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }
    }
}
